<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://www.w3.org/XML/1998/namespace"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cursos"
        android:textSize="24sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:gravity="center"/>

    <EditText
        android:id="@+id/edtPesquisar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Pesquisar curso"/>

    <TextView
        android:id="@+id/txtSemCursos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nenhum curso disponível no momento."
        android:gravity="center"
        android:textSize="16sp"
        android:padding="32dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCursos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>