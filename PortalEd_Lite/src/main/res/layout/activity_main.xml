<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F0F9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_login"
            android:elevation="12dp">

            <!-- CABEÇALHO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:background="@drawable/bg_header_login">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎓"
                    android:textSize="48sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PortalEd"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aprenda no seu ritmo"
                    android:textColor="#EAF6FF"
                    android:textSize="15sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- FORMULÁRIO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_input"
                    android:hint="exemplo@email.com"
                    android:paddingHorizontal="16dp"
                    android:inputType="textEmailAddress" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senha"
                    android:textStyle="bold"
                    android:textColor="#374151"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/edtSenha"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:hint="••••••••••••••••"
                    android:paddingHorizontal="16dp"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btnEntrar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Entrar"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0284C7" />

                <TextView
                    android:id="@+id/txtEsqueciSenha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Esqueceu a senha?"
                    android:textColor="#0284C7"
                    android:textSize="14sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/txtCriarConta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Criar nova conta"
                    android:textStyle="bold"
                    android:textColor="#0284C7"
                    android:textSize="14sp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

            <!-- RODAPÉ -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8FAFC"
                android:gravity="center"
                android:padding="16dp"
                android:text="@PortalEd_Lite"
                android:textColor="#0277BD"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>