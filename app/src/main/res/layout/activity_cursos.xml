<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_media_previous"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cursos"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0284C7"
            android:layout_marginStart="12dp"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"/>

        <EditText
            android:id="@+id/edtPesquisa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Buscar cursos..."
            android:textSize="14sp"/>

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <Button
                android:text="Todos"
                android:background="@drawable/bg_tab_active"
                android:layout_height="10dp"
                android:layout_width="10dp"
                />

            <Button
                android:text="Tecnologia"
                android:background="@drawable/bg_tab"
                android:layout_height="10dp"
                android:layout_width="10dp"
                />

            <Button
                android:text="Design"
                android:background="@drawable/bg_tab"
                android:layout_height="10dp"
                android:layout_width="10dp"
                />

            <Button
                android:text="Idiomas"
                android:background="@drawable/bg_tab"
                android:layout_height="10dp"
                android:layout_width="10dp"
                />

            <Button
                android:text="Matemática"
                android:background="@drawable/bg_tab"
                android:layout_height="10dp"
                android:layout_width="10dp"
                />

        </LinearLayout>

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCursos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#F8FAFC"
        android:padding="16dp"/>

</LinearLayout>